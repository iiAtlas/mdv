# Code Signing & Notarization
# Copy this file to .env and fill in your values

# Your Apple ID email or App Store Connect API Key ID
AC_USERNAME=""

# App-specific password OR path to .p8 API key file
# For app-specific password: use the password directly
# For API key: use the full path to your .p8 file
AC_PASSWORD=""

# Your Apple Developer Team ID (10-character code)
# Find it with: security find-identity -v -p codesigning
AC_TEAM_ID=""

# App Store Connect API Issuer ID (only needed if using API key)
# Find it at: https://appstoreconnect.apple.com/access/integrations/api
AC_PROVIDER=""

# GitHub Token (for releases)
# Create at: https://github.com/settings/tokens
GITHUB_TOKEN=""
