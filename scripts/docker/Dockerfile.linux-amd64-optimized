# Default: Builder stage (current behavior - outputs binary to volume)
# ==============================================================================

# Default command: build Linux GUI for amd64
CMD ["sh", "-c", "WAILS_PLATFORMS=linux/amd64 ./scripts/build-wails.sh"]
